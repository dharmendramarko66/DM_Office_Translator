#!/bin/bash
set -e

INSTALL_DIR="/usr/share/dm-office-tools"
MENU_FILE="/usr/share/applications/dm-office-tools.desktop"

echo "[INFO] Configuring DM Office Translator..."

# ------------------------------------------------------------
# 1. Ensure installed files are executable
# ------------------------------------------------------------

chmod 755 "$INSTALL_DIR/stable/run_english_to_hindi.sh" 2>/dev/null || true
chmod 755 "$INSTALL_DIR/stable/run_hindi_to_english.sh" 2>/dev/null || true
chmod 755 "$INSTALL_DIR/stable/english_to_hindi_hybrid.py" 2>/dev/null || true
chmod 755 "$INSTALL_DIR/stable/hindi_to_english_hybrid.py" 2>/dev/null || true
chmod 755 "$INSTALL_DIR/stable/smart_dictionary_manager.py" 2>/dev/null || true

# ------------------------------------------------------------
# 2. Detect the real desktop user
# ------------------------------------------------------------

TARGET_USER="${SUDO_USER:-}"

if [[ -z "$TARGET_USER" || "$TARGET_USER" == "root" ]]; then
    TARGET_USER="$(logname 2>/dev/null || true)"
fi

if [[ -z "$TARGET_USER" || "$TARGET_USER" == "root" ]]; then
    TARGET_USER="$(who 2>/dev/null | awk 'NR==1 {print $1}')"
fi

if [[ -z "$TARGET_USER" || "$TARGET_USER" == "root" ]]; then
    echo "[WARN] Could not determine desktop user."
    echo "[WARN] Dictionary initialization and shortcuts will be skipped."
    exit 0
fi

USER_HOME="$(getent passwd "$TARGET_USER" | cut -d: -f6)"

if [[ -z "$USER_HOME" || ! -d "$USER_HOME" ]]; then
    echo "[WARN] Could not determine home directory for $TARGET_USER."
    exit 0
fi

# ------------------------------------------------------------
# 3. Create user dictionary directory
# ------------------------------------------------------------

USER_DICT_DIR="$USER_HOME/.dm_office_tools/dictionary"

mkdir -p "$USER_DICT_DIR"

# ------------------------------------------------------------
# 4. Initialize dictionaries only if they do not exist
# ------------------------------------------------------------

if [[ ! -f "$USER_DICT_DIR/english_to_hindi_dictionary.txt" ]]; then
    if [[ -f "$INSTALL_DIR/dictionary/english_to_hindi_dictionary.txt" ]]; then
        cp "$INSTALL_DIR/dictionary/english_to_hindi_dictionary.txt" \
           "$USER_DICT_DIR/english_to_hindi_dictionary.txt"
    fi
fi

if [[ ! -f "$USER_DICT_DIR/hindi_to_english_dictionary.txt" ]]; then
    if [[ -f "$INSTALL_DIR/dictionary/hindi_to_english_dictionary.txt" ]]; then
        cp "$INSTALL_DIR/dictionary/hindi_to_english_dictionary.txt" \
           "$USER_DICT_DIR/hindi_to_english_dictionary.txt"
    fi
fi

# ------------------------------------------------------------
# 5. Preserve ownership
# ------------------------------------------------------------

chown -R "$TARGET_USER:$TARGET_USER" "$USER_HOME/.dm_office_tools"

# ------------------------------------------------------------
# 6. Configure GNOME keyboard shortcuts
# ------------------------------------------------------------

configure_shortcuts() {
    local USER_NAME="$1"
    local USER_HOME="$2"

    local XDG_RUNTIME_DIR
    local DBUS_SESSION_BUS_ADDRESS

    XDG_RUNTIME_DIR="/run/user/$(id -u "$USER_NAME")"
    DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"

    if [[ ! -S "$XDG_RUNTIME_DIR/bus" ]]; then
        echo "[WARN] GNOME session bus not available; keyboard shortcuts were not configured."
        return 0
    fi

    runuser -u "$USER_NAME" -- \
        env \
        HOME="$USER_HOME" \
        USER="$USER_NAME" \
        LOGNAME="$USER_NAME" \
        XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
        DBUS_SESSION_BUS_ADDRESS="$DBUS_SESSION_BUS_ADDRESS" \
        bash -s <<'SHORTCUT_SCRIPT'

set -e

CUSTOM_SCHEMA="org.gnome.settings-daemon.plugins.media-keys"

E2H_COMMAND="/usr/bin/dm-office-tools-e2h"
H2E_COMMAND="/usr/bin/dm-office-tools-h2e"

E2H_BINDING="<Alt>space"
H2E_BINDING="<Alt>h"

CUSTOM_KEYS="$(gsettings get "$CUSTOM_SCHEMA" custom-keybindings 2>/dev/null || echo "@as []")"

remove_slot() {
    local SLOT="$1"

    CUSTOM_KEYS="$(echo "$CUSTOM_KEYS" | \
        sed "s#'$SLOT', ##; s#,'$SLOT'##; s#'$SLOT'##")"

    dconf reset -f "$SLOT" 2>/dev/null || true
}

add_slot() {
    local SLOT="$1"

    if [ "$CUSTOM_KEYS" = "@as []" ] || [ -z "$CUSTOM_KEYS" ]; then
        CUSTOM_KEYS="['$SLOT']"
    else
        CUSTOM_KEYS="$(echo "$CUSTOM_KEYS" | \
            sed "s#]#, '$SLOT']#")"
    fi

    gsettings set "$CUSTOM_SCHEMA" custom-keybindings "$CUSTOM_KEYS"
}

get_free_slot() {
    local index=0
    local slot

    while true
    do
        slot="/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom${index}/"

        if ! echo "$CUSTOM_KEYS" | grep -Fq "$slot"; then
            echo "$slot"
            return
        fi

        index=$((index + 1))
    done
}

# =========================================================
# E2H — Alt+Space
# =========================================================

E2H_SLOT=""
E2H_FOUND=0

for KEY in $(echo "$CUSTOM_KEYS" | sed "s/@as //" | tr -d "[],'")
do
    [ -z "$KEY" ] && continue

    COMMAND="$(dconf read "${KEY}command" 2>/dev/null || true)"

    if echo "$COMMAND" | grep -Fq "/usr/bin/dm-office-tools-e2h" || \
       echo "$COMMAND" | grep -Fq "/opt/dm-office-tools/stable/run_english_to_hindi.sh"; then

        if [ "$E2H_FOUND" -eq 0 ]; then
            E2H_SLOT="$KEY"
            E2H_FOUND=1
        else
            remove_slot "$KEY"
        fi
    fi
done

if [ "$E2H_FOUND" -eq 0 ]; then
    # Never overwrite an unrelated user's Alt+Space shortcut.
    # Create a new SOHT slot instead.
    E2H_SLOT="$(get_free_slot)"
    add_slot "$E2H_SLOT"
fi

gsettings set "$CUSTOM_SCHEMA" custom-keybindings "$CUSTOM_KEYS"

dconf write "${E2H_SLOT}name" "'SOHT English to Hindi'"
dconf write "${E2H_SLOT}command" "'$E2H_COMMAND'"
dconf write "${E2H_SLOT}binding" "'$E2H_BINDING'"

# =========================================================
# H2E — Alt+H
# =========================================================

H2E_SLOT=""
H2E_FOUND=0

for KEY in $(echo "$CUSTOM_KEYS" | sed "s/@as //" | tr -d "[],'")
do
    [ -z "$KEY" ] && continue

    COMMAND="$(dconf read "${KEY}command" 2>/dev/null || true)"

    if echo "$COMMAND" | grep -Fq "/usr/bin/dm-office-tools-h2e" || \
       echo "$COMMAND" | grep -Fq "/opt/dm-office-tools/stable/run_hindi_to_english.sh"; then

        if [ "$H2E_FOUND" -eq 0 ]; then
            H2E_SLOT="$KEY"
            H2E_FOUND=1
        else
            remove_slot "$KEY"
        fi
    fi
done

if [ "$H2E_FOUND" -eq 0 ]; then
    # Never overwrite an unrelated user's Alt+H shortcut.
    # Create a new SOHT slot instead.
    H2E_SLOT="$(get_free_slot)"
    add_slot "$H2E_SLOT"
fi

gsettings set "$CUSTOM_SCHEMA" custom-keybindings "$CUSTOM_KEYS"

dconf write "${H2E_SLOT}name" "'SOHT Hindi to English'"
dconf write "${H2E_SLOT}command" "'$H2E_COMMAND'"
dconf write "${H2E_SLOT}binding" "'$H2E_BINDING'"

# =========================================================
# Verify final shortcuts
# =========================================================

FINAL_KEYS="$(gsettings get "$CUSTOM_SCHEMA" custom-keybindings)"

E2H_OK=0
H2E_OK=0

for KEY in $(echo "$FINAL_KEYS" | sed "s/@as //" | tr -d "[],'")
do
    [ -z "$KEY" ] && continue

    NAME="$(dconf read "${KEY}name" 2>/dev/null || true)"
    COMMAND="$(dconf read "${KEY}command" 2>/dev/null || true)"
    BINDING="$(dconf read "${KEY}binding" 2>/dev/null || true)"

    if [ "$NAME" = "'SOHT English to Hindi'" ] && \
       [ "$BINDING" = "'<Alt>space'" ] && \
       echo "$COMMAND" | grep -Fq "/usr/bin/dm-office-tools-e2h"; then
        E2H_OK=1
    fi

    if [ "$NAME" = "'SOHT Hindi to English'" ] && \
       [ "$BINDING" = "'<Alt>h'" ] && \
       echo "$COMMAND" | grep -Fq "/usr/bin/dm-office-tools-h2e"; then
        H2E_OK=1
    fi
done

[ "$E2H_OK" -eq 1 ] && echo "E2H Alt+Space ........ OK"
[ "$H2E_OK" -eq 1 ] && echo "H2E Alt+H ............ OK"

if [ "$E2H_OK" -ne 1 ] || [ "$H2E_OK" -ne 1 ]; then
    echo "Keyboard shortcut verification failed."
    exit 1
fi

SHORTCUT_SCRIPT
}


if command -v gsettings >/dev/null 2>&1; then
    configure_shortcuts "$TARGET_USER" "$USER_HOME"
else
    echo "[WARN] gsettings not available; keyboard shortcuts were not configured."
fi

# ------------------------------------------------------------
# 7. Remove obsolete desktop launchers
# ------------------------------------------------------------

rm -f \
    "$USER_HOME/Desktop/Smart_Dictionary_Manager.desktop" \
    "$USER_HOME/Desktop/SOHT_Dictionary_Manager.desktop" \
    "$USER_HOME/.local/share/applications/Smart_Dictionary_Manager.desktop" \
    "$USER_HOME/.local/share/applications/SOHT_Dictionary_Manager.desktop"

chown "$TARGET_USER:$TARGET_USER" "$USER_HOME" 2>/dev/null || true

# ------------------------------------------------------------
# 8. Refresh desktop caches
# ------------------------------------------------------------

if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
fi

if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -q /usr/share/icons/hicolor 2>/dev/null || true
fi

echo "[OK] DM Office Translator configured successfully."
echo "[OK] English → Hindi : Alt+Space"
echo "[OK] Hindi → English : Alt+H"

exit 0
