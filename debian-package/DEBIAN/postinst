#!/bin/bash
set -e

INSTALL_DIR="/opt/dm-office-tools"
MENU_DIR="/usr/share/applications"

echo "Configuring DM Office Tools..."

# =========================================================
# 1. Make application files executable
# =========================================================

chmod +x "$INSTALL_DIR/stable/run_hindi.sh"
chmod +x "$INSTALL_DIR/stable/run_hindi_to_english.sh"
chmod +x "$INSTALL_DIR/stable/english_to_hindi_hybrid.py"
chmod +x "$INSTALL_DIR/stable/hindi_to_english_hybrid.py"
chmod +x "$INSTALL_DIR/dictionary/smart_dictionary_manager.py"

# =========================================================
# 2. Detect the real installing user
# =========================================================

TARGET_USER="${SUDO_USER:-}"

# GUI / App Center installation normally runs postinst as root
# and may not provide SUDO_USER.
#
# Do NOT depend on session Type being x11/wayland.
# On some Ubuntu environments loginctl reports the active desktop
# session as tty while the user's graphical DBus session is active.
#
# Prefer an active non-root session attached to a seat and having
# a valid user DBus session bus.

if [ -z "$TARGET_USER" ] || [ "$TARGET_USER" = "root" ]; then

    TARGET_USER=""

    while read -r SESSION_ID SESSION_UID SESSION_USER SESSION_SEAT SESSION_TTY SESSION_STATE REST; do

        [ -z "$SESSION_ID" ] && continue
        [ -z "$SESSION_USER" ] && continue
        [ "$SESSION_USER" = "root" ] && continue
        [ "$SESSION_STATE" != "active" ] && continue

        if [ -n "$SESSION_SEAT" ] && \
           [ "$SESSION_SEAT" != "-" ] && \
           [ -S "/run/user/$SESSION_UID/bus" ]; then

            TARGET_USER="$SESSION_USER"
            break
        fi

    done < <(loginctl list-sessions --no-legend 2>/dev/null)

fi

# Fallback for terminal installation.
if [ -z "$TARGET_USER" ] || [ "$TARGET_USER" = "root" ]; then
    TARGET_USER="$(logname 2>/dev/null || true)"
fi

if [ -z "$TARGET_USER" ] || [ "$TARGET_USER" = "root" ]; then
    TARGET_USER=""
fi

USER_HOME=""

if [ -n "$TARGET_USER" ]; then
    USER_HOME="$(getent passwd "$TARGET_USER" | cut -d: -f6)"
fi

# =========================================================
# 3. Create ONE user dictionary location
# =========================================================

if [ -n "$TARGET_USER" ] && [ -n "$USER_HOME" ] && [ -d "$USER_HOME" ]; then

    USER_DICT_DIR="$USER_HOME/.dm_office_tools/dictionary"

    mkdir -p "$USER_DICT_DIR"

    # Never overwrite user's existing dictionaries.
    if [ ! -f "$USER_DICT_DIR/dictionary.txt" ]; then
        cp -f \
            "$INSTALL_DIR/dictionary/dictionary.txt" \
            "$USER_DICT_DIR/dictionary.txt"
    fi

    if [ ! -f "$USER_DICT_DIR/hindi_to_english_dictionary.txt" ]; then
        cp -f \
            "$INSTALL_DIR/dictionary/hindi_to_english_dictionary.txt" \
            "$USER_DICT_DIR/hindi_to_english_dictionary.txt"
    fi

    chown -R "$TARGET_USER":"$TARGET_USER" \
        "$USER_HOME/.dm_office_tools" 2>/dev/null || true

    echo "User dictionary ........ OK"

else
    echo "User dictionary ........ SKIPPED"
    echo "No logged-in installation user detected."
fi

# =========================================================
# 4. Configure GNOME keyboard shortcuts
# =========================================================

configure_shortcuts() {

    local USER_NAME="$1"
    local USER_HOME="$2"

    local XDG_RUNTIME_DIR
    local DBUS_SESSION_BUS_ADDRESS

    XDG_RUNTIME_DIR="/run/user/$(id -u "$USER_NAME")"
    DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"

    if [ ! -S "$XDG_RUNTIME_DIR/bus" ]; then
        echo "GNOME session bus not available."
        return 0
    fi

    runuser -u "$USER_NAME" -- \
        env \
        HOME="$USER_HOME" \
        USER="$USER_NAME" \
        LOGNAME="$USER_NAME" \
        XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
        DBUS_SESSION_BUS_ADDRESS="$DBUS_SESSION_BUS_ADDRESS" \
        bash -s <<'SHORTCUT_SCRIPT'

set -e

CUSTOM_SCHEMA="org.gnome.settings-daemon.plugins.media-keys"

E2H_COMMAND="/bin/bash /opt/dm-office-tools/stable/run_hindi.sh"
H2E_COMMAND="/bin/bash /opt/dm-office-tools/stable/run_hindi_to_english.sh"

E2H_BINDING="<Alt>space"
H2E_BINDING="<Alt>h"

CUSTOM_KEYS="$(gsettings get "$CUSTOM_SCHEMA" custom-keybindings 2>/dev/null || echo "@as []")"

remove_slot() {

    local SLOT="$1"

    CUSTOM_KEYS="$(echo "$CUSTOM_KEYS" | \
        sed "s#'$SLOT', ##; s#,'$SLOT'##; s#'$SLOT'##")"

    dconf reset -f "$SLOT" 2>/dev/null || true
}

add_slot() {

    local SLOT="$1"

    if [ "$CUSTOM_KEYS" = "@as []" ] || [ -z "$CUSTOM_KEYS" ]; then
        CUSTOM_KEYS="['$SLOT']"
    else
        CUSTOM_KEYS="$(echo "$CUSTOM_KEYS" | \
            sed "s#]#, '$SLOT']#")"
    fi

    gsettings set "$CUSTOM_SCHEMA" custom-keybindings "$CUSTOM_KEYS"
}

get_free_slot() {

    local index=0
    local slot

    while true
    do
        slot="/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/custom${index}/"

        if ! echo "$CUSTOM_KEYS" | grep -Fq "$slot"; then
            echo "$slot"
            return
        fi

        index=$((index + 1))
    done
}

# =========================================================
# E2H — Alt+Space
# =========================================================

E2H_SLOT=""
E2H_FOUND=0

for KEY in $(echo "$CUSTOM_KEYS" | sed "s/@as //" | tr -d "[],'")
do
    [ -z "$KEY" ] && continue

    COMMAND="$(dconf read "${KEY}command" 2>/dev/null || true)"

    if echo "$COMMAND" | grep -Fq "/opt/dm-office-tools/stable/run_hindi.sh"; then

        if [ "$E2H_FOUND" -eq 0 ]; then
            E2H_SLOT="$KEY"
            E2H_FOUND=1
        else
            remove_slot "$KEY"
        fi
    fi
done

if [ "$E2H_FOUND" -eq 0 ]; then

    OLD_SLOT=""

    for KEY in $(echo "$CUSTOM_KEYS" | sed "s/@as //" | tr -d "[],'")
    do
        [ -z "$KEY" ] && continue

        BINDING="$(dconf read "${KEY}binding" 2>/dev/null || true)"

        if [ "$BINDING" = "'$E2H_BINDING'" ]; then
            OLD_SLOT="$KEY"
            break
        fi
    done

    if [ -n "$OLD_SLOT" ]; then
        E2H_SLOT="$OLD_SLOT"
    else
        E2H_SLOT="$(get_free_slot)"
        add_slot "$E2H_SLOT"
    fi
fi

# Save any duplicate-slot removals before configuring H2E.
gsettings set "$CUSTOM_SCHEMA" custom-keybindings "$CUSTOM_KEYS"

dconf write "${E2H_SLOT}name" "'SOHT English to Hindi'"
dconf write "${E2H_SLOT}command" "'$E2H_COMMAND'"
dconf write "${E2H_SLOT}binding" "'$E2H_BINDING'"

# =========================================================
# H2E — Alt+H
# =========================================================

H2E_SLOT=""
H2E_FOUND=0

for KEY in $(echo "$CUSTOM_KEYS" | sed "s/@as //" | tr -d "[],'")
do
    [ -z "$KEY" ] && continue

    COMMAND="$(dconf read "${KEY}command" 2>/dev/null || true)"

    if echo "$COMMAND" | grep -Fq "/opt/dm-office-tools/stable/run_hindi_to_english.sh"; then

        if [ "$H2E_FOUND" -eq 0 ]; then
            H2E_SLOT="$KEY"
            H2E_FOUND=1
        else
            remove_slot "$KEY"
        fi
    fi
done

if [ "$H2E_FOUND" -eq 0 ]; then

    OLD_SLOT=""

    for KEY in $(echo "$CUSTOM_KEYS" | sed "s/@as //" | tr -d "[],'")
    do
        [ -z "$KEY" ] && continue

        BINDING="$(dconf read "${KEY}binding" 2>/dev/null || true)"

        if [ "$BINDING" = "'$H2E_BINDING'" ]; then
            OLD_SLOT="$KEY"
            break
        fi
    done

    if [ -n "$OLD_SLOT" ]; then
        H2E_SLOT="$OLD_SLOT"
    else
        H2E_SLOT="$(get_free_slot)"
        add_slot "$H2E_SLOT"
    fi
fi

# Save any duplicate-slot removals before final verification.
gsettings set "$CUSTOM_SCHEMA" custom-keybindings "$CUSTOM_KEYS"

dconf write "${H2E_SLOT}name" "'SOHT Hindi to English'"
dconf write "${H2E_SLOT}command" "'$H2E_COMMAND'"
dconf write "${H2E_SLOT}binding" "'$H2E_BINDING'"

# =========================================================
# Verify shortcuts
# =========================================================

FINAL_KEYS="$(gsettings get "$CUSTOM_SCHEMA" custom-keybindings)"

E2H_OK=0
H2E_OK=0

for KEY in $(echo "$FINAL_KEYS" | sed "s/@as //" | tr -d "[],'")
do
    [ -z "$KEY" ] && continue

    NAME="$(dconf read "${KEY}name" 2>/dev/null || true)"
    COMMAND="$(dconf read "${KEY}command" 2>/dev/null || true)"
    BINDING="$(dconf read "${KEY}binding" 2>/dev/null || true)"

    if [ "$NAME" = "'SOHT English to Hindi'" ] && \
       [ "$BINDING" = "'<Alt>space'" ] && \
       echo "$COMMAND" | grep -Fq "/opt/dm-office-tools/stable/run_hindi.sh"; then
        E2H_OK=1
    fi

    if [ "$NAME" = "'SOHT Hindi to English'" ] && \
       [ "$BINDING" = "'<Alt>h'" ] && \
       echo "$COMMAND" | grep -Fq "/opt/dm-office-tools/stable/run_hindi_to_english.sh"; then
        H2E_OK=1
    fi
done

[ "$E2H_OK" -eq 1 ] && echo "E2H Alt+Space ........ OK"
[ "$H2E_OK" -eq 1 ] && echo "H2E Alt+H ............ OK"

if [ "$E2H_OK" -ne 1 ] || [ "$H2E_OK" -ne 1 ]; then
    echo "Keyboard shortcut verification failed."
    exit 1
fi

SHORTCUT_SCRIPT
}

if [ -n "$TARGET_USER" ] && [ -n "$USER_HOME" ] && [ -d "$USER_HOME" ]; then
    configure_shortcuts "$TARGET_USER" "$USER_HOME"
else
    echo "Keyboard shortcuts .... SKIPPED"
    echo "No logged-in GNOME user detected."
fi

# =========================================================
# 5. Remove obsolete duplicate user Dictionary Manager
# =========================================================

if [ -n "$USER_HOME" ] && [ -d "$USER_HOME/.local/share/applications" ]; then

    rm -f \
        "$USER_HOME/.local/share/applications/Smart_Dictionary_Manager.desktop" \
        "$USER_HOME/.local/share/applications/SOHT_Dictionary_Manager.desktop"

    chown "$TARGET_USER":"$TARGET_USER" \
        "$USER_HOME/.local/share/applications" 2>/dev/null || true
fi

# =========================================================
# 6. Refresh desktop and icon databases
# =========================================================

update-desktop-database "$MENU_DIR" 2>/dev/null || true
gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true

echo
echo "DM Office Tools configured successfully."

exit 0
