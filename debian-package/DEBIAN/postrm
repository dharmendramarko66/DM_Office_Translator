#!/bin/bash

INSTALL_DIR="/opt/dm-office-tools"

E2H_COMMAND="/bin/bash $INSTALL_DIR/stable/run_hindi.sh"
H2E_COMMAND="/bin/bash $INSTALL_DIR/stable/run_hindi_to_english.sh"

cleanup_user_shortcuts() {

    local USER_NAME="$1"
    local USER_HOME="$2"

    local XDG_RUNTIME_DIR
    local DBUS_SESSION_BUS_ADDRESS

    XDG_RUNTIME_DIR="/run/user/$(id -u "$USER_NAME")"
    DBUS_SESSION_BUS_ADDRESS="unix:path=$XDG_RUNTIME_DIR/bus"

    if [ ! -S "$XDG_RUNTIME_DIR/bus" ]; then
        return 0
    fi

    runuser -u "$USER_NAME" -- \
        env \
        HOME="$USER_HOME" \
        USER="$USER_NAME" \
        LOGNAME="$USER_NAME" \
        XDG_RUNTIME_DIR="$XDG_RUNTIME_DIR" \
        DBUS_SESSION_BUS_ADDRESS="$DBUS_SESSION_BUS_ADDRESS" \
        bash -s <<'SHORTCUT_CLEANUP'

set -e

CUSTOM_SCHEMA="org.gnome.settings-daemon.plugins.media-keys"

CUSTOM_KEYS="$(gsettings get "$CUSTOM_SCHEMA" custom-keybindings 2>/dev/null || echo "@as []")"

NEW_KEYS="$CUSTOM_KEYS"

for KEY in $(echo "$CUSTOM_KEYS" | sed "s/@as //" | tr -d "[],'")
do
    [ -z "$KEY" ] && continue

    COMMAND="$(dconf read "${KEY}command" 2>/dev/null || true)"
    NAME="$(dconf read "${KEY}name" 2>/dev/null || true)"

    REMOVE=0

    if echo "$COMMAND" | grep -Fq "/opt/dm-office-tools/stable/run_hindi.sh"; then
        REMOVE=1
    fi

    if echo "$COMMAND" | grep -Fq "/opt/dm-office-tools/stable/run_hindi_to_english.sh"; then
        REMOVE=1
    fi

    if [ "$REMOVE" -eq 1 ]; then

        NEW_KEYS="$(echo "$NEW_KEYS" | \
            sed "s#'$KEY', ##; s#,'$KEY'##; s#'$KEY'##")"

        dconf reset -f "$KEY" 2>/dev/null || true

        echo "Removed DM Office Tools shortcut: $NAME"

    fi
done

if [ "$NEW_KEYS" = "" ]; then
    NEW_KEYS="@as []"
fi

gsettings set "$CUSTOM_SCHEMA" custom-keybindings "$NEW_KEYS"

SHORTCUT_CLEANUP
}

# =========================================================
# Remove shortcuts from active graphical users
# =========================================================

while read -r SESSION_ID SESSION_UID SESSION_USER SESSION_SEAT SESSION_TTY SESSION_STATE REST; do

    [ -z "$SESSION_ID" ] && continue
    [ -z "$SESSION_USER" ] && continue
    [ "$SESSION_USER" = "root" ] && continue
    [ "$SESSION_STATE" != "active" ] && continue

    if [ -n "$SESSION_SEAT" ] && \
       [ "$SESSION_SEAT" != "-" ] && \
       [ -S "/run/user/$SESSION_UID/bus" ]; then

        USER_HOME="$(getent passwd "$SESSION_USER" | cut -d: -f6)"

        if [ -n "$USER_HOME" ] && [ -d "$USER_HOME" ]; then
            cleanup_user_shortcuts "$SESSION_USER" "$USER_HOME"
        fi
    fi

done < <(loginctl list-sessions --no-legend 2>/dev/null)

# =========================================================
# Remove legacy user current directory
# =========================================================

# v2.0.x legacy architecture used:
# ~/.dm_office_tools/current/
#
# Remove ONLY the obsolete current directory.
# User dictionaries and backups must remain untouched.

for USER_HOME in /home/*; do

    [ -d "$USER_HOME" ] || continue

    LEGACY_CURRENT="$USER_HOME/.dm_office_tools/current"

    if [ -d "$LEGACY_CURRENT" ]; then
        rm -rf "$LEGACY_CURRENT"
        echo "Removed legacy current directory: $LEGACY_CURRENT"
    fi

done

# =========================================================
# Remove Python cache files left under package directory
# =========================================================

if [ -d "$INSTALL_DIR" ]; then

    find "$INSTALL_DIR" \
        -type d \
        -name "__pycache__" \
        -prune \
        -exec rm -rf {} + 2>/dev/null || true

fi

# Remove empty package directories only.
if [ -d "$INSTALL_DIR/stable" ]; then
    rmdir "$INSTALL_DIR/stable" 2>/dev/null || true
fi

if [ -d "$INSTALL_DIR/dictionary" ]; then
    rmdir "$INSTALL_DIR/dictionary" 2>/dev/null || true
fi

if [ -d "$INSTALL_DIR" ]; then
    rmdir "$INSTALL_DIR" 2>/dev/null || true
fi

exit 0
